{
  "info": {
    "name": "ClinSight Backend API",
    "description": "Complete API collection for ClinSight medical diagnosis system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as Physician",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"auth_token\", jsonData.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"physician\",\n  \"password\": \"demo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Register New User",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new_doctor\",\n  \"email\": \"doctor@hospital.com\",\n  \"password\": \"SecurePass123!\",\n  \"full_name\": \"Dr. New Doctor\",\n  \"role\": \"physician\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Patients",
      "item": [
        {
          "name": "Create Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"patient_id\", jsonData.uuid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Robert\",\n  \"last_name\": \"Johnson\",\n  \"date_of_birth\": \"1965-03-15\",\n  \"gender\": \"male\",\n  \"phone\": \"+1-555-0123\",\n  \"email\": \"robert.johnson@email.com\",\n  \"address\": \"123 Main Street\",\n  \"city\": \"Boston\",\n  \"state\": \"MA\",\n  \"zip_code\": \"02101\",\n  \"chief_complaint\": \"Persistent cough and fever for 5 days\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/patients",
              "host": ["{{base_url}}"],
              "path": ["api", "patients"]
            }
          }
        },
        {
          "name": "Get Patient",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/patients/{{patient_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "patients", "{{patient_id}}"]
            }
          }
        },
        {
          "name": "List Patients",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/patients?page=1&page_size=10",
              "host": ["{{base_url}}"],
              "path": ["api", "patients"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "page_size", "value": "10"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Imaging",
      "item": [
        {
          "name": "Create Imaging Study",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"study_date\": \"2026-02-12T10:30:00\",\n  \"modality\": \"xray\",\n  \"body_part\": \"Chest\",\n  \"description\": \"Chest X-ray PA and Lateral views\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/imaging?patient_id={{patient_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "imaging"],
              "query": [
                {"key": "patient_id", "value": "{{patient_id}}"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Labs & Vitals",
      "item": [
        {
          "name": "Add Lab Result - WBC",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"test_name\": \"WBC\",\n  \"test_value\": 14.5,\n  \"unit\": \"10^9/L\",\n  \"reference_range_low\": 4.0,\n  \"reference_range_high\": 11.0,\n  \"test_date\": \"2026-02-12T08:00:00\",\n  \"notes\": \"Elevated white blood cell count\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/labs/labs?patient_id={{patient_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "labs", "labs"],
              "query": [
                {"key": "patient_id", "value": "{{patient_id}}"}
              ]
            }
          }
        },
        {
          "name": "Add Vital Signs",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"temperature\": 38.7,\n  \"temperature_unit\": \"C\",\n  \"systolic_bp\": 128,\n  \"diastolic_bp\": 82,\n  \"heart_rate\": 98,\n  \"respiratory_rate\": 22,\n  \"oxygen_saturation\": 94,\n  \"weight\": 82.5,\n  \"height\": 175,\n  \"measurement_date\": \"2026-02-12T10:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/labs/vitals?patient_id={{patient_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "labs", "vitals"],
              "query": [
                {"key": "patient_id", "value": "{{patient_id}}"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Clinical Notes",
      "item": [
        {
          "name": "Create Clinical Note",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Progress Note - Day 1\",\n  \"content\": \"Patient presents with 5-day history of productive cough, fever, and shortness of breath. Physical exam reveals decreased breath sounds in right lower lobe. Assessment: Community-acquired pneumonia.\",\n  \"note_type\": \"progress_note\",\n  \"note_date\": \"2026-02-12T11:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/notes?patient_id={{patient_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "notes"],
              "query": [
                {"key": "patient_id", "value": "{{patient_id}}"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "AI Diagnostic",
      "item": [
        {
          "name": "Generate Diagnostic Report",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient_id\": \"{{patient_id}}\",\n  \"query\": \"Generate comprehensive diagnostic assessment for pneumonia\",\n  \"clinical_notes\": \"Patient with fever, cough, and abnormal chest X-ray\",\n  \"include_images\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/diagnostic/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "diagnostic", "generate"]
            }
          }
        },
        {
          "name": "Extract Entities",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Patient presents with fever, cough, and dyspnea. Started on Azithromycin and Ceftriaxone.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/diagnostic/extract-entities",
              "host": ["{{base_url}}"],
              "path": ["api", "diagnostic", "extract-entities"]
            }
          }
        }
      ]
    },
    {
      "name": "Audit Logs",
      "item": [
        {
          "name": "List Audit Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/audit?page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "audit"],
              "query": [
                {"key": "page", "value": "1"},
                {"key": "page_size", "value": "20"}
              ]
            },
            "description": "Requires compliance or admin role"
          }
        }
      ]
    }
  ]
}
